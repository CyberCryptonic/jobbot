# Copy to .env and fill in. chmod 600 .env. Never commit .env.

# Anthropic API. Set a monthly spend cap in the console before you paste this.
ANTHROPIC_API_KEY=

# Mailbox the pipeline reads and sends from. Must be the same address you apply from.
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.example.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465

# Job sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Push notifications (self-hosted ntfy). Treat the topic like a password.
NTFY_URL=http://localhost:2586
NTFY_TOPIC=change-me-to-something-random

# Where the nightly report goes
REPORT_TO=

# Storage. Both default to files in the project root when unset:
# jobbot.db and resume.pdf. The resume ships read-only: chmod 444 it.
DB_PATH=
RESUME_PATH=

# Safety knobs live in config.json, not here, and ship safe:
#   submission.dry_run = true          (logs intended actions, applies to nothing)
#   submission.auto_submit.enabled = false  (the browser head never launches)
#   submission.verify_first_n = 20     (first 20 live sends are screenshotted for review)
#   quota.daily_max = 10               (daily application quota)
#   cost.monthly_cap_usd = 40          (hard monthly API budget)
# Read SECURITY.md before you change any of them.
